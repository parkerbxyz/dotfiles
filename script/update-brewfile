#!/usr/bin/env bash
set -euo pipefail

# Change the working directory to the script/js directory
cd "$(dirname "$0")"/js

# Generate into a temp file first, so a failed run can't wipe out the Brewfile
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

node generate-brewfile.mjs > "$tmp"
mv "$tmp" ../../Brewfile
